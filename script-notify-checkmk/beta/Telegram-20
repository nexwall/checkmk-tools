# Cooldown evaluation
# ---------------------------------------------------------------------------


def _get_cooldown_seconds(category):
    cd = CFG.get("cooldown", {})
    per_cat = cd.get("per_category", {})
    if category in per_cat and per_cat[category]:
        return per_cat[category]
    return cd.get("default_seconds", 3600)


def _is_recovery(event):
    if event["is_host"]:
        return event["new_state"] in ("UP",)
    return event["new_state"] in ("OK",)


def _evaluate_cooldown(state, event, category, ts):
    cd = CFG.get("cooldown", {})
    if not cd.get("enabled", True):
        return ("BYPASS", "Cooldown disabled")
    cd_mode = cd.get("mode", "audit")
    preserve = cd.get("preserve_recovery", True)
    if preserve and _is_recovery(event):
        return ("COOLDOWN_BYPASS_RECOVERY",
                "Recovery notification — bypassing cooldown")
    cd_sec = _get_cooldown_seconds(category)
    if cd_sec <= 0:
        return ("BYPASS", "Cooldown seconds is zero or negative")
    cd_tracking = state.get("cooldown", {})
    last_delivered = cd_tracking.get("last_delivered", {})
    cat_map = last_delivered.get(category, {})
    last_ts = cat_map.get(event["hostname"], 0)
    if last_ts <= 0:
        return ("BYPASS", "No previous delivery for this host+category")
    elapsed = ts - last_ts
    if elapsed >= cd_sec:
        return ("BYPASS", "Cooldown expired")
    remaining = cd_sec - elapsed
    if cd_mode == "enforce":
        return ("SUPPRESSED_COOLDOWN",
                f"Cooldown active — {remaining}s remaining since last delivery")
    return ("WOULD_SUPPRESS_COOLDOWN",
            f"Audit mode — would suppress ({remaining}s cooldown remaining)")


def _update_delivery_cooldown(event):
    category, _ = is_supported_transition(event)
    if category is None:
        return
    state_path = get_state_path()
    lock_path = get_lock_path(state_path)
    try:
        with StateLock(lock_path):
            state = read_state(state_path)
            state = migrate_state(state)
            if "cooldown" not in state:
                state["cooldown"] = {"last_delivered": {}, "samples": {}}
            cd_tracking = state["cooldown"]
            if "last_delivered" not in cd_tracking:
                cd_tracking["last_delivered"] = {}
            if category not in cd_tracking["last_delivered"]:
                cd_tracking["last_delivered"][category] = {}
            cd_tracking["last_delivered"][category][event["hostname"]] = now()
            write_state(state_path, state)
    except Exception as exc:
        LOG.warning("FAIL_OPEN: cooldown state update error: %s", exc)


def _update_cooldown_adaptive(state, event, category, ts, was_delivered):
    ad = CFG.get("adaptive", {}).get("cooldown", {})
    if not ad.get("enabled", True):
        return
    try:
        if "cooldown" not in state:
            state["cooldown"] = {"last_delivered": {}, "samples": {}}
        samples = state["cooldown"].setdefault("samples", {})
        if category not in samples:
            samples[category] = []
        samples[category].append(ts)
        cutoff = ts - 30 * 86400
        samples[category] = [s for s in samples[category] if s >= cutoff]
        if len(samples[category]) > 500:
            samples[category] = samples[category][-500:]
    except Exception as exc:
        LOG.warning("FAIL_OPEN: cooldown adaptive sample error: %s", exc)


def _recalculate_cooldown_recommendation(state, event, category, ts):
    ad = CFG.get("adaptive", {}).get("cooldown", {})
    if not ad.get("enabled", True):
        return
    min_samples = ad.get("minimum_notification_samples", 20)
    min_days = ad.get("minimum_learning_days", 3)
    min_reduction = ad.get("minimum_expected_reduction_percent", 30)
    candidates = ad.get("candidate_cooldowns", [1800, 3600, 7200, 10800, 21600])
    try:
        tracking = state.get("cooldown", {})
        samples = tracking.get("samples", {}).get(category, [])
        if len(samples) < min_samples:
            LOG.info("ADAPTIVE_COOLDOWN_RECOMMENDATION: "
                     "insufficient samples (%d < %d) for %s/%s",
                     len(samples), min_samples, event["hostname"], category)
            return
        first_ts = min(samples) if samples else ts
        learning_days = (ts - first_ts) / 86400
        if learning_days < min_days:
            LOG.info("ADAPTIVE_COOLDOWN_RECOMMENDATION: "
                     "learning period too short (%.1f < %d days) for %s/%s",
                     learning_days, min_days, event["hostname"], category)
            return
        total_notifications = len(samples)
        best_candidate = candidates[0]
        best_reduction = 0
        for cd_sec in candidates:
            would_pass = 0
            would_block = 0
            last_delivery = 0
            for s_ts in sorted(samples):
                if last_delivery and (s_ts - last_delivery) < cd_sec:
                    would_block += 1
                else:
                    would_pass += 1
                    last_delivery = s_ts
            reduction = (would_block / total_notifications * 100) if total_notifications else 0
            if reduction > best_reduction:
                best_reduction = reduction
                best_candidate = cd_sec
        auto_apply_msg = str(ad.get("auto_apply", False)).lower()
        if best_reduction >= min_reduction:
            LOG.info("ADAPTIVE_COOLDOWN_RECOMMENDATION: "
                     "%s/%s best_candidate=%ds expected_reduction=%.0f%% "
                     "samples=%d learning_days=%.1f auto_apply=%s",
                     event["hostname"], category,
                     best_candidate, best_reduction,
                     total_notifications, learning_days, auto_apply_msg)
            # --- Auto-apply cooldown if enabled ---
            if ad.get("auto_apply", False):
                try:
                    cfg_path = Path(CONFIG_PATH)
                    cfg_data = json.loads(cfg_path.read_text()) if cfg_path.is_file() else {}
                    prev_sec = cfg_data.get("cooldown", {}).get("default_seconds")
                    if "cooldown" not in cfg_data:
                        cfg_data["cooldown"] = {}
                    cfg_data["cooldown"]["default_seconds"] = best_candidate
                    if "per_category" not in cfg_data["cooldown"]:
                        cfg_data["cooldown"]["per_category"] = {}
                    cfg_data["cooldown"]["per_category"][category] = best_candidate
                    cfg_path.write_text(json.dumps(cfg_data, indent=4))
                    LOG.info("ADAPTIVE_COOLDOWN_AUTO_APPLY: "
                             "%s/%s cooldown=%ds (was %s) "
                             "expected_reduction=%.0f%%",
                             event["hostname"], category,
                             best_candidate, str(prev_sec or "default"),
                             best_reduction)
                    # Update in-memory CFG for current invocation
                    if "cooldown" not in CFG:
                        CFG["cooldown"] = {}
                    CFG["cooldown"]["default_seconds"] = best_candidate
                    if "per_category" not in CFG["cooldown"]:
                        CFG["cooldown"]["per_category"] = {}
                    CFG["cooldown"]["per_category"][category] = best_candidate
                except Exception as aa_exc:
                    LOG.warning("AUTO_APPLY_ERROR: %s/%s: %s",
                               event["hostname"], category, aa_exc)
        else:
            LOG.info("ADAPTIVE_COOLDOWN_RECOMMENDATION: "
                     "%s/%s insufficient reduction (%.0f%% < %d%%) "
                     "for any candidate — samples=%d learning_days=%.1f",
                     event["hostname"], category,
                     best_reduction, min_reduction,
                     total_notifications, learning_days)
    except Exception as exc:
        LOG.warning("FAIL_OPEN: cooldown recommendation error: %s", exc)


