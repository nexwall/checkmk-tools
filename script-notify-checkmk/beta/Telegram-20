STATE_SCHEMA_VERSION = 3


def get_state_path():
    path = Path(STATE_DIR)
    path.mkdir(parents=True, exist_ok=True)
    return path / "state.json"


_STATE_SIZE_LIMIT = 10 * 1024 * 1024  # 10 MB safety threshold


def read_state(state_path):
    try:
        size = state_path.stat().st_size
        if size > _STATE_SIZE_LIMIT:
            LOG.warning(
                "State file %s is %d bytes — exceeds %d byte limit. "
                "Attempting to load anyway.",
                state_path, size, _STATE_SIZE_LIMIT,
            )
    except OSError:
        pass
    try:
        raw = state_path.read_bytes()
        data = json.loads(raw)
        if isinstance(data, dict):
            return data
        LOG.warning("State file %s is not a dict — resetting", state_path)
    except (FileNotFoundError, json.JSONDecodeError, OSError) as exc:
        LOG.debug("Cannot read state %s: %s — starting fresh", state_path, exc)
    return {}


def write_state(state_path, state):
    tmp = None
    try:
        fd, tmp_name = tempfile.mkstemp(
            dir=str(state_path.parent),
            prefix=".state_tmp_",
        )
        os.close(fd)
        tmp = Path(tmp_name)
        tmp.write_text(json.dumps(state, indent=2, sort_keys=True))
        tmp.chmod(0o640)
        os.replace(str(tmp), str(state_path))
    except Exception as exc:
        LOG.error("Cannot write state file %s: %s", state_path, exc)
        if tmp and tmp.exists():
            tmp.unlink(missing_ok=True)
        raise


def get_lock_path(state_path):
    return state_path.parent / "state.lock"


class StateLock:
    def __init__(self, lock_path):
        self._lock_path = lock_path
        self._fd = None

    def __enter__(self):
        self._lock_path.parent.mkdir(parents=True, exist_ok=True)
        self._fd = self._lock_path.open("w")
        fcntl.flock(self._fd.fileno(), fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc_info):
        if self._fd:
            fcntl.flock(self._fd.fileno(), fcntl.LOCK_UN)
            self._fd.close()
            self._fd = None
        self._lock_path.unlink(missing_ok=True)


