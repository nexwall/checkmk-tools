def _deep_merge(base, overlay):
    for key, val in overlay.items():
        if key in base and isinstance(base[key], dict) and isinstance(val, dict):
            _deep_merge(base[key], val)
        else:
            base[key] = val


def load_config():
    cfg = json.loads(json.dumps(CONFIG))
    path = Path(CONFIG_PATH)
    if not path.is_file():
        LOG.debug("Config file %s not found — using defaults", CONFIG_PATH)
        return cfg
    try:
        data = json.loads(path.read_text())
        if not isinstance(data, dict):
            LOG.warning("Config file %s: root is not a dict — using defaults", CONFIG_PATH)
            return cfg
        _deep_merge(cfg, data)
        adaptive = cfg.get("adaptive", {})
        if adaptive.get("mode") not in ("learning", None):
            LOG.warning("Unsupported adaptive.mode=%r — forcing learning", adaptive.get("mode"))
            adaptive["mode"] = "learning"
        if adaptive.get("auto_apply", False):
            LOG.warning("adaptive.auto_apply=true is not supported — forcing false")
            adaptive["auto_apply"] = False
        if cfg.get("mode") != "audit":
            LOG.warning("mode=%s is not supported — forcing audit", cfg.get("mode"))
            cfg["mode"] = "audit"
        LOG.info("Configuration loaded from %s", CONFIG_PATH)
    except (json.JSONDecodeError, OSError) as exc:
        LOG.warning("Cannot load config %s: %s — using defaults", CONFIG_PATH, exc)
    return cfg


