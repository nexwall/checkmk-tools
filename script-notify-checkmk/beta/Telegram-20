        ]:
            cat_rec = rec.get(cat_key, {})
            ad = cat_rec.get("adaptive", {})
            configured = CFG.get(cat_key, {}).get("trigger_transitions", "?")
            recommended = ad.get("recommended_threshold", "\u2014")
            status = ad.get("recommendation_status", "\u2014")
            first_obs = ad.get("first_observation", 0)
            samples = len(ad.get("transition_samples", []))
            peak_30m = ad.get("peak_30m", 0)
            last_recalc = ad.get("last_recalculation", 0)
            learning_days = (now() - first_obs) / 86400 if first_obs else 0
            print(f"\n    {cat_label}:")
            print(f"      configured threshold:    {configured}")
            print(f"      recommended threshold:   {recommended}")
            print(f"      learning period:         {learning_days:.1f} days")
            print(f"      sample count:            {samples}")
            print(f"      peak 30m transitions:    {peak_30m}")
            print(f"      last recalculation:      "
                  f"{time.strftime('%Y-%m-%d %H:%M UTC', time.gmtime(last_recalc)) if last_recalc else 'never'}")
            print(f"      recommendation status:   {status}")

    if hosts_found == 0:
        print("\n  No hosts in state yet.")
    print(f"\n{'=' * 72}")
    return 0


# ---------------------------------------------------------------------------
# CLI pre-validation
# ---------------------------------------------------------------------------


def _prevalidate_argv():
    """Reject mixed utility arguments before argparse processes them.

    argparse's built-in --help/-h action calls sys.exit(0) when it
    encounters the flag, before rejecting any extra positional arguments.
    This function catches those invalid combinations early:

        --help extra             -> exit 2
        -h extra                 -> exit 2
        --version extra          -> exit 2
        --learning-report extra  -> exit 2
        --unknown                -> exit 2
        positional               -> exit 2

    Must run before parser.parse_args() so that --help cannot
    short-circuit the check.  Normal (zero-arg) Checkmk invocation
    passes through unchanged.
    """
    argv = sys.argv[1:]
    if not argv:
        return

    known_flags = {"--help", "-h", "--version", "--learning-report"}
    has_utility = any(a in known_flags for a in argv)
    has_other = any(a not in known_flags for a in argv)

    if has_utility and has_other:
        print(
            f"{SCRIPT_NAME}: error: utility flags accept no additional arguments",
            file=sys.stderr,
        )
        sys.exit(2)

    for a in argv:
        if a.startswith("-") and a not in known_flags:
            print(
                f"{SCRIPT_NAME}: error: unrecognized argument: {a}",
                file=sys.stderr,
            )
            sys.exit(2)

    # Positional arguments without any utility flag reach argparse normally
    # and are rejected there with exit code 2.


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------


def main():
    """Entry point.

    Supports --learning-report for read-only report output.
    When called as a Checkmk notification handler, processes one event
    with structured diagnostic logging.
    """
    _prevalidate_argv()

    parser = argparse.ArgumentParser(
        description=SCRIPT_DESCRIPTION,
    )
    parser.add_argument(
        "--learning-report", action="store_true",
        help="Print a read-only adaptive learning report",
    )
    parser.add_argument(
        "--version", action="store_true",
        help="Print version and exit",
    )
    args = parser.parse_args()

    if args.version:
        print(f"{SCRIPT_NAME} {VERSION}")
        return 0

    if args.learning_report:
        return print_learning_report()

    # --- Notification processing with structured logging ---
    execution_id = _uuid.uuid4().hex
    start_time = time.monotonic()

    notify_type = os.environ.get("NOTIFY_NOTIFICATIONTYPE", "PROBLEM")
    notify_reason = os.environ.get("NOTIFY_NOTIFICATIONREASON", "")

    _safe_log("INFO", {
        "execution_id": execution_id,
        "status": "INVOKED",
        "notification_type": notify_type,
        "notification_reason": notify_reason,
    })

    delivery_attempted = False
    delivery_result = "NOT_ATTEMPTED"
    final_rc = 0
    final_result = "DELIVERED"

    try:
        event = classify_notification()
        _safe_log("INFO", {
            "execution_id": execution_id,
            "status": "ACCEPTED",
            "host": event["hostname"],
            "service": event.get("service_desc", "(host)"),
            "old_state": event["old_state"],
            "new_state": event["new_state"],
            "notification_type": notify_type,
            "notification_reason": notify_reason,
        })

        decision = evaluate_rate_limit(event)
        log_decision(decision, event, {})

        suppress_decisions = {"SUPPRESS", "SUPPRESSED_COOLDOWN"}
        would_suppress_decisions = {"WOULD_SUPPRESS", "WOULD_SUPPRESS_COOLDOWN"}

        if decision["decision"] in suppress_decisions:
            final_result = "SUPPRESSED"
            delivery_result = "NOT_ATTEMPTED"
            log_status = "SUPPRESSED_COOLDOWN" if "COOLDOWN" in decision["decision"] else "SUPPRESSED"
            _safe_log("INFO", {
                "execution_id": execution_id,
                "status": log_status,
                "host": event["hostname"],
                "category": decision.get("category", "?"),
                "reason": decision.get("reason", "?"),
                "cooldown_blocked": "COOLDOWN" in decision["decision"],
            })
            _safe_log("INFO", {
                "execution_id": execution_id,
                "status": "COMPLETE",
                "result": final_result,
                "exit_code": 0,
                "delivery_attempted": False,
                "delivery_result": delivery_result,
                "duration_ms": int((time.monotonic() - start_time) * 1000),
            })
            return 0

        if decision["decision"] in would_suppress_decisions:
            _safe_log("INFO", {
                "execution_id": execution_id,
                "status": "WOULD_SUPPRESS_COOLDOWN",
                "host": event["hostname"],
                "category": decision.get("category", "?"),
                "reason": decision.get("reason", "?"),
            })

        # Build and send Telegram message
        token = os.environ.get("TELEGRAM_TOKEN", "")
        chat_id = os.environ.get("TELEGRAM_CHAT_ID", "")

        if not token or not chat_id:
            final_result = "INVALID"
            delivery_result = "NOT_ATTEMPTED"
            final_rc = 1
            _safe_log("ERROR", {
                "execution_id": execution_id,
                "status": "INVALID",
                "reason": "TELEGRAM_TOKEN or TELEGRAM_CHAT_ID not set",
            })
            sys.stderr.write(
                f"{SCRIPT_NAME} v{VERSION}: TELEGRAM_TOKEN or TELEGRAM_CHAT_ID "
                "not set. Check OMD environment.\n"
            )
            _safe_log("INFO", {
                "execution_id": execution_id,
                "status": "COMPLETE",
                "result": final_result,
                "exit_code": final_rc,
                "delivery_attempted": False,
                "delivery_result": delivery_result,
                "duration_ms": int((time.monotonic() - start_time) * 1000),
            })
            return final_rc

        delivery_attempted = True
        _safe_log("INFO", {
            "execution_id": execution_id,
            "status": "DELIVERING",
            "host": event["hostname"],
            "service": event.get("service_desc", "(host)"),
        })

        text, button = build_telegram_message(event)

        deferred_to_background = False

        try:
            send_telegram(token, chat_id, text, button)
            rc = 0
        except RuntimeError as exc:
            _safe_log("ERROR", {
                "execution_id": execution_id,
                "status": "FAILED",
                "host": event["hostname"],
                "service": event.get("service_desc", "(host)"),
                "error": str(exc),
            })
            sys.stderr.write(f"{SCRIPT_NAME} v{VERSION}: {exc}\n")
            if _spawn_background_retry(token, chat_id, text, button, event):
                sys.stderr.write(
                    f"{SCRIPT_NAME} v{VERSION}: handing off to background retry "
                    f"(up to {RETRY_MAX_WAIT}s); reporting success now to avoid "
                    "a recorded notification failure over a transient flap\n"
                )
                deferred_to_background = True
                rc = 0
            else:
                rc = 1

        if deferred_to_background:
            final_result = "DEFERRED"
            delivery_result = "DEFERRED_BACKGROUND_RETRY"
            # Cooldown is intentionally NOT updated here - only the background
            # retry, on confirmed delivery, applies it. If it never succeeds,
            # a real subsequent problem on this host/category must not be
            # silently suppressed by a message that was never delivered.
            _safe_log("INFO", {
                "execution_id": execution_id,
                "status": "DEFERRED",
                "host": event["hostname"],
                "service": event.get("service_desc", "(host)"),
                "rc": rc,
                "note": "background retry in progress, see telegram_retry Event Console events for the final outcome",
            })
        elif rc == 0:
            final_result = "DELIVERED"
            delivery_result = "SUCCESS"
            _update_delivery_cooldown(event)
            _safe_log("INFO", {
                "execution_id": execution_id,
                "status": "DELIVERED",
                "host": event["hostname"],
                "service": event.get("service_desc", "(host)"),
                "rc": rc,
            })
        else:
            final_result = "FAILED"
            delivery_result = "FAILED"
            _safe_log("ERROR", {
                "execution_id": execution_id,
                "status": "FAILED",
                "host": event["hostname"],
                "service": event.get("service_desc", "(host)"),
                "rc": rc,
            })

        if decision["decision"] in ("WOULD_SUPPRESS", "FAIL_OPEN"):
            _safe_log("INFO", {
                "execution_id": execution_id,
                "status": "AUDIT_NOT_SUPPRESSED",
                "host": event["hostname"],
                "category": decision.get("category", "?"),
                "reason": decision.get("reason", "?"),
            })

        final_rc = rc

    except Exception:
        exc_info = sys.exc_info()
        exception_type = exc_info[0].__name__ if exc_info[0] else "?"
        exc_str = str(exc_info[1]) if exc_info[1] else ""
        final_result = "ERROR"
        delivery_result = "NOT_ATTEMPTED"
        final_rc = 2
        _safe_log("ERROR", {
            "execution_id": execution_id,
            "status": "ERROR",
            "exception_type": exception_type,
            "sanitized_error": exc_str,
            "delivery_attempted": delivery_attempted,
            "delivery_result": delivery_result,
        })

    _safe_log("INFO", {
        "execution_id": execution_id,
        "status": "COMPLETE",
        "result": final_result,
        "exit_code": final_rc,
        "delivery_attempted": delivery_attempted,
        "delivery_result": delivery_result,
        "duration_ms": int((time.monotonic() - start_time) * 1000),
    })

    return final_rc


if __name__ == "__main__":
    sys.exit(main())
