def migrate_state(state):
    sv = state.get("schema_version", 1)
    if sv >= STATE_SCHEMA_VERSION:
        return state
    if sv == 1:
        for hostname, rec in list(state.items()):
            if hostname == "schema_version":
                continue
            if not isinstance(rec, dict):
                continue
            for cat in ("host_state", "service_state_ping"):
                cat_rec = rec.get(cat)
                if isinstance(cat_rec, dict):
                    if "adaptive" not in cat_rec:
                        cat_rec["adaptive"] = _fresh_learning_record()
        state["schema_version"] = 2
        LOG.info("State schema migrated v1 → v2")
    if sv == 2:
        if "cooldown" not in state:
            state["cooldown"] = {
                "last_delivered": {},
                "samples": {},
            }
        for cat in ("host_state", "service_state_ping"):
            if cat not in state["cooldown"]["last_delivered"]:
                state["cooldown"]["last_delivered"][cat] = {}
            if cat not in state["cooldown"]["samples"]:
                state["cooldown"]["samples"][cat] = []
        for hostname, rec in list(state.items()):
            if hostname.startswith("_") or not isinstance(rec, dict):
                continue
            for cat in ("host_state", "service_state_ping"):
                cat_rec = rec.get(cat)
                if isinstance(cat_rec, dict):
                    ldt = cat_rec.pop("last_delivery_ts", 0)
                    if ldt:
                        state["cooldown"]["last_delivered"][cat][hostname] = ldt
        state["schema_version"] = 3
        LOG.info("State schema migrated v2 → v3 (cooldown tracking)")
    return state


