def _cmk_url_valid(url):
    return bool(url) and url.startswith(("http://", "https://")) and "<" not in url


def get_reverse_dns_url():
    try:
        req = urllib.request.Request("https://api.ipify.org")
        req.add_header("User-Agent", "Telegram-20-Notifier")
        with urllib.request.urlopen(req, timeout=5) as resp:
            public_ip = resp.read().decode().strip()
        hostname = _socket.gethostbyaddr(public_ip)[0]
        if hostname and not _ISP_PTR.search(hostname):
            return f"https://{hostname}/monitoring"
    except Exception:
        pass
    return None


def get_status_prefix(state):
    s = state.upper()
    if s in ("OK", "UP"):
        return "\U0001f7e2 [OK]"
    if s in ("WARN", "WARNING"):
        return "\U0001f7e1 [WARN]"
    if s in ("CRIT", "CRITICAL", "DOWN"):
        return "\U0001f534 [CRIT]"
    if s == "UNKNOWN":
        return "\U0001f7e1 [UNKNOWN]"
    return "[?]"


def build_telegram_message(event, cmk_url_override=None):
    """Build a Telegram message dict matching the production telegram script.

    Returns (text, reply_markup) where text is the HTML message body and
    reply_markup is a JSON-encoded inline keyboard or None.
    """
    hostname = event["hostname"]
    real_ip = event.get("real_ip", event.get("host_address", ""))
    output = event.get("output", "N/A")
    button = None

    url = cmk_url_override if cmk_url_override else CMK_URL
    if not url:
        url = get_reverse_dns_url() or "__NOT_EXPOSED__"

    if event["is_host"]:
        state = event["new_state"]
        prefix = get_status_prefix(state)
        text = (
            f"{prefix} Host: {hostname}\n"
            f"IP: {real_ip}\n"
            f"Output: {output}"
        )
        if _cmk_url_valid(url):
            host_link = f"{url}/check_mk/view.py?view_name=host&host={hostname}&site=monitoring"
            button = json.dumps({"inline_keyboard": [[
                {"text": "Host", "url": host_link},
            ]]})
        elif url == "__NOT_EXPOSED__":
            button = json.dumps({"inline_keyboard": [[
                {"text": "\U0001f512 Panel unreachable (server not exposed)",
                 "callback_data": "not_exposed"},
            ]]})
    else:
        state = event["new_state"]
        service = event.get("service_desc", "SERVICE")
        prefix = get_status_prefix(state)
        text = (
            f"{prefix} Servizio: {service}\n"
            f"Host: {hostname} ({real_ip})\n"
            f"Output: {output}"
        )
        if _cmk_url_valid(url):
            svc_enc = urllib.parse.quote(service, safe='')
            service_link = (
                f"{url}/check_mk/view.py?view_name=service"
                f"&host={hostname}&service={svc_enc}&site=monitoring"
            )
            host_link = (
                f"{url}/check_mk/view.py?view_name=host"
                f"&host={hostname}&site=monitoring"
            )
            button = json.dumps({"inline_keyboard": [[
                {"text": "Servizio", "url": service_link},
                {"text": "Host", "url": host_link},
            ]]})
        elif url == "__NOT_EXPOSED__":
            button = json.dumps({"inline_keyboard": [[
                {"text": "\U0001f512 Panel unreachable (server not exposed)",
                 "callback_data": "not_exposed"},
            ]]})

    customer_name = os.environ.get("TELEGRAM_CUSTOMER_NAME", "")
    if customer_name:
        text = f"[{customer_name}] {text}"

    return text, button


def send_telegram(token, chat_id, text, reply_markup=None):
    """Send a Telegram message via the Bot API.

    Raises RuntimeError on API error.  Returns True on success.
    Never logs the full bot URL (which contains the secret token).
    """
    if not token or not chat_id:
        raise RuntimeError("TELEGRAM_TOKEN or TELEGRAM_CHAT_ID not set")

    api_url = f"https://api.telegram.org/bot{token}/sendMessage"
    params = {
        "chat_id": chat_id,
        "text": text,
        "parse_mode": "HTML",
    }
    if reply_markup is not None:
        params["reply_markup"] = reply_markup

    data = urllib.parse.urlencode(params).encode("utf-8")
    req = urllib.request.Request(api_url, data=data, method="POST")

    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            body = resp.read().decode("utf-8", errors="replace")
    except urllib.error.HTTPError as exc:
        brief = exc.read().decode("utf-8", errors="replace")[:200]
        raise RuntimeError(f"Telegram API HTTP {exc.code}: {brief}") from exc
    except (urllib.error.URLError, OSError) as exc:
        raise RuntimeError(f"Telegram connection error: {exc}") from exc

    if '"ok":true' not in body and '"ok": true' not in body:
        raise RuntimeError(f"Telegram API error: {body[:200]}")

    sys.stdout.write("Telegram OK: message sent\n")


def _log_ec_event(priority, application, text):
    """Best-effort: write one syslog-formatted line to the local Event
    Console socket. Never raises - a logging failure must never affect
    the notification flow."""
    try:
        pri = 16 * 8 + priority  # facility local0 (16)
        hostname = os.environ.get("NOTIFY_HOSTNAME") or _socket.gethostname()
        ts = time.strftime("%b %d %H:%M:%S")
        line = f"<{pri}>{ts} {hostname} {application}: {text}\n"
        s = _socket.socket(_socket.AF_UNIX, _socket.SOCK_STREAM)
        s.settimeout(3)
        s.connect(EC_SOCKET)
        s.sendall(line.encode("utf-8", errors="replace"))
        s.close()
    except Exception:
        pass


def _spawn_background_retry(token, chat_id, text, reply_markup, event):
    """Detach a background process that keeps retrying the Telegram send
    for up to RETRY_MAX_WAIT seconds, so the caller can return success to
    CheckMK right away instead of blocking (and failing) the notification
    pipeline on a transient flap.

    Only on confirmed eventual delivery does the background process apply
    the same cooldown-state update that an immediate success would have
    triggered (_update_delivery_cooldown) - if it never succeeds, the
    cooldown state is left untouched, so a real subsequent problem on the
    same host/category is never silently suppressed by a message that was
    never actually delivered. The final outcome is logged to the Event
    Console either way.

    Returns True if the background retry was handed off successfully
    (caller should treat this as delivered from CheckMK's point of view),
    False if forking itself failed (caller should report the original
    failure instead - nothing was actually attempted in that case).
    """
    try:
        pid = os.fork()
        if pid > 0:
            return True  # parent: handed off, caller reports success now
    except OSError:
        return False  # can't fork - nothing more we can do, report the real failure

    # First child: detach fully from the notification script's process
    # group/session so it survives after CheckMK reaps the parent.
    os.setsid()
    try:
        pid2 = os.fork()
        if pid2 > 0:
            os._exit(0)
    except OSError:
        os._exit(1)

    # Second child: the actual background retry worker, fully detached.
    os.chdir("/")
    devnull = os.open(os.devnull, os.O_RDWR)
    os.dup2(devnull, 0)
    os.dup2(devnull, 1)
    os.dup2(devnull, 2)

    hostname = event.get("hostname", "?")
    service = event.get("service_desc", "(host)")
    started = time.time()
    deadline = started + RETRY_MAX_WAIT
    attempt = 1
    last_exc = None
    while time.time() < deadline:
        time.sleep(RETRY_INTERVAL)
        attempt += 1
        try:
            send_telegram(token, chat_id, text, reply_markup)
            _update_delivery_cooldown(event)
            _log_ec_event(
                6, "telegram_retry",
                f"Telegram-20 message delivered after {attempt} attempts "
                f"(~{int(time.time() - started)}s) host={hostname} service={service}"
            )
            os._exit(0)
        except Exception as exc:
            last_exc = exc

    _log_ec_event(
        3, "telegram_retry",
        f"Telegram-20 message permanently failed after {attempt} attempts "
        f"over {RETRY_MAX_WAIT}s host={hostname} service={service}: {last_exc}"
    )
    os._exit(1)


