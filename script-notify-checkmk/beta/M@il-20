class _SafeFileHandler(logging.FileHandler):
    """FileHandler that never raises on emit().

    Defense-in-depth: catches every emit() exception so no LOG call
    can ever propagate into business logic.  Falls back to stderr.
    """
    def emit(self, record):
        try:
            super().emit(record)
        except Exception:
            try:
                sys.stderr.write("%s: log write failed\n" % SCRIPT_NAME)
                sys.stderr.flush()
            except Exception:
                pass


