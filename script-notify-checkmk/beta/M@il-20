def setup_logger():
    """Configure a file logger under the Checkmk site log area.

    Best-effort: falls back to stderr if the log directory or file
    cannot be created.
    """
    log = logging.getLogger(SCRIPT_NAME)
    log.setLevel(logging.DEBUG)
    log.handlers.clear()

    fmt = logging.Formatter(
        "%(asctime)s [%(levelname)s] %(message)s",
        datefmt="%Y-%m-%d %H:%M:%S",
    )

    handler = None
    try:
        if LOG_DIR:
            os.makedirs(LOG_DIR, exist_ok=True)
            log_path = os.path.join(LOG_DIR, "mail-20.log")
            handler = _SafeFileHandler(log_path)
    except Exception as exc:
        if os.environ.get("MAIL20_DEBUG") == "1":
            sys.stderr.write(f"{SCRIPT_NAME}: log init: {exc}\n")

    if handler is None:
        handler = logging.StreamHandler(sys.stderr)

    handler.setFormatter(fmt)
    log.addHandler(handler)
    return log


