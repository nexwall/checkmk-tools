def classify_notification():
    """Read Checkmk environment variables and classify the event."""
    to_email = os.environ.get("NOTIFY_CONTACTEMAIL", "root@localhost")
    hostname = os.environ.get("NOTIFY_HOSTNAME", "Unknown")
    site = os.environ.get("NOTIFY_OMD_SITE", "monitoring")
    date = os.environ.get("NOTIFY_SHORTDATETIME", "")
    host_address = os.environ.get("NOTIFY_HOSTADDRESS", "N/A")
    real_ip = os.environ.get("NOTIFY_HOSTLABEL_real_ip", host_address)
    frp = os.environ.get("NOTIFY_HOSTLABEL_frp_tunnel", "no")
    output = os.environ.get("NOTIFY_HOSTOUTPUT", "N/A")
    long_output = os.environ.get("NOTIFY_LONGHOSTOUTPUT", "")
    service_desc = os.environ.get("NOTIFY_SERVICEDESC", "")

    is_service = bool(service_desc) and not service_desc.startswith("$")

    if is_service:
        old_state = (
            os.environ.get("NOTIFY_PREVIOUSSERVICEHARDSHORTSTATE")
            or os.environ.get("NOTIFY_LASTSERVICESTATE", "OK")
        )
        new_state = (
            os.environ.get("NOTIFY_SERVICESHORTSTATE")
            or os.environ.get("NOTIFY_SERVICESTATE", "UNKNOWN")
        )
        output = os.environ.get("NOTIFY_SERVICEOUTPUT", "N/A")
        long_output = os.environ.get("NOTIFY_LONGSERVICEOUTPUT", "")
    else:
        old_state = (
            os.environ.get("NOTIFY_PREVIOUSHOSTHARDSHORTSTATE")
            or os.environ.get("NOTIFY_LASTHOSTSTATE", "UP")
        )
        new_state = (
            os.environ.get("NOTIFY_HOSTSHORTSTATE")
            or os.environ.get("NOTIFY_HOSTSTATE", "DOWN")
        )

    return {
        "is_host": not is_service,
        "hostname": hostname,
        "service_desc": service_desc,
        "old_state": old_state.upper(),
        "new_state": new_state.upper(),
        "output": output,
        "long_output": long_output,
        "host_address": host_address,
        "real_ip": real_ip,
        "frp": frp,
        "site": site,
        "date": date,
        "to_email": to_email,
    }


def is_supported_transition(event):
    """Determine whether the event is a tracked transition type.

    Returns (category, is_transition).
    """
    if event["is_host"]:
        valid_pairs = {("UP", "DOWN"), ("DOWN", "UP")}
        pair = (event["old_state"], event["new_state"])
        if pair in valid_pairs:
            return "host_state", True
        return "host_state", False
    else:
        if event["service_desc"] != "PING":
            return None, False
        valid_pairs = {("OK", "CRIT"), ("CRIT", "OK"),
                       ("OK", "CRITICAL"), ("CRITICAL", "OK")}
        pair = (event["old_state"], event["new_state"])
        if pair in valid_pairs:
            return "service_state_ping", True
        if event["new_state"] in ("WARNING", "WARN", "UNKNOWN", "UNKN"):
            LOG.info("%s/%s PING state %s → %s — not counted",
                     event["hostname"], event["service_desc"],
                     event["old_state"], event["new_state"])
            return "service_state_ping", False
        return "service_state_ping", False


def make_category_record():
    """Return a fresh per-category state record."""
    return {
        "last_state": None,
        "transitions": [],
        "suppression_until": 0,
        "suppressed_count": 0,
    }


def get_host_state(state, hostname):
    """Return the per-host state dict, creating it if absent."""
    if hostname not in state:
        state[hostname] = {
            "host_state": make_category_record(),
            "service_state_ping": make_category_record(),
        }
    return state[hostname]


def prune_transitions(transitions, window):
    """Remove transition timestamps older than `window` seconds ago."""
    cutoff = now() - window
    return [t for t in transitions if t >= cutoff]


def evaluate_rate_limit(event):
    """Evaluate the rate-limit decision for one notification event.

    Returns a decision dict.  Fail-open: any unexpected exception sends
    the mail normally.
    """
    state_path = get_state_path()
    lock_path = get_lock_path(state_path)
    category, is_transition = is_supported_transition(event)

    if category is None:
        return {
            "decision": "BYPASS",
            "category": None,
            "reason": "Not a tracked notification type",
        }

    cfg_section = CFG.get(category, {})
    enabled = cfg_section.get("enabled", True)
    window = cfg_section.get("observation_window", 1800)
    trigger = cfg_section.get("trigger_transitions", 4)
    suppress_time = cfg_section.get("suppression_time", 3600)

    if not enabled:
        return {
            "decision": "BYPASS",
            "category": category,
            "reason": f"{category} rate-limiting disabled",
        }

    try:
        with StateLock(lock_path):
            state = read_state(state_path)
            state = migrate_state(state)
            host_rec = get_host_state(state, event["hostname"])
            cat_rec = host_rec[category]

            last_state = cat_rec.get("last_state")
            transitions = cat_rec.get("transitions", [])
            suppression_until = cat_rec.get("suppression_until", 0)
            suppressed_count = cat_rec.get("suppressed_count", 0)

            # Real transition only when state differs from last recorded
            if is_transition and last_state is not None:
                if event["new_state"] == last_state:
                    is_transition = False

            ts = now()
            cat_rec["last_state"] = event["new_state"]

            decision = "SEND"
            reason = "Normal notification"

            if suppression_until > ts:
                if is_transition:
                    suppressed_count += 1
                    cat_rec["suppressed_count"] = suppressed_count

                mode = CFG.get("mode", "audit")
                if mode == "enforce":
                    decision = "SUPPRESS"
                    reason = (
                        f"Suppression active until "
                        f"{suppression_until} "
                        f"(transition #{suppressed_count} suppressed)"
                    )
                else:
                    decision = "WOULD_SUPPRESS"
                    reason = (
                        f"Audit mode — would suppress (active until "
                        f"{suppression_until}, "
                        f"transition #{suppressed_count} counted)"
                    )
            else:
                if is_transition:
                    transitions.append(ts)
                    transitions = prune_transitions(transitions, window)
                    count = len(transitions)

                    # Threshold is inclusive: transitions >= trigger
                    # triggers suppression entry.
                    if count >= trigger:
                        suppression_until = ts + suppress_time
                        suppressed_count = 0
                        cat_rec["suppression_until"] = suppression_until
                        cat_rec["suppressed_count"] = 0

                        mode = CFG.get("mode", "audit")
                        if mode == "enforce":
                            decision = "SEND"
                            reason = (
                                f"Suppression entered "
                                f"(transition #{count}/{trigger} "
                                f"in {window}s)"
                            )
                            LOG.info(
                                "%s/%s %s suppression started — "
                                "%d transitions in %ds, "
                                "ban until %d",
                                event["hostname"], category, category,
                                count, window, suppression_until,
                            )
                        else:
                            decision = "SEND"
                            reason = (
                                f"Audit — threshold reached "
                                f"({count}/{trigger}) — "
                                f"would suppress next, "
                                f"suppression_until={suppression_until}"
                            )
                            LOG.info(
                                "%s/%s %s threshold reached "
                                "(audit mode) — %d transitions in %ds",
                                event["hostname"], category, category,
                                count, window,
                            )
                    else:
                        decision = "SEND"
                        reason = (
                            f"Transition #{count}/{trigger} "
                            f"in {window}s"
                        )
                else:
                    decision = "SEND"
                    reason = (
                        f"State {event['old_state']} → "
                        f"{event['new_state']} — no transition counted"
                    )

            cat_rec["transitions"] = transitions
            cat_rec["suppression_until"] = suppression_until
            cat_rec["suppressed_count"] = suppressed_count

            # --- Adaptive transition learning update ---
            _update_adaptive(cat_rec, category, is_transition, ts)

            # --- Cooldown evaluation (after transition limiter) ---
            cd_decision, cd_reason = _evaluate_cooldown(state, event, category, ts)

            # Safe combine: transition enforce suppression can never be overridden.
            # Cooldown can only add suppression, never remove it.
            if decision == "SUPPRESS":
                # Transition enforce suppression — keep it, cooldown cannot override
                pass
            elif cd_decision == "SUPPRESSED_COOLDOWN":
                # Cooldown enforce suppression — overrides transition's SEND/WOULD_SUPPRESS
                decision = cd_decision
                reason = cd_reason
            elif cd_decision == "WOULD_SUPPRESS_COOLDOWN" and decision == "SEND":
                # Cooldown audit — only overrides transition's SEND
                decision = cd_decision
                reason = cd_reason
            elif cd_decision == "COOLDOWN_BYPASS_RECOVERY":
                _safe_log("INFO", {
                    "status": "COOLDOWN_BYPASS_RECOVERY",
                    "host": event["hostname"],
                    "category": category,
                    "old_state": event["old_state"],
                    "new_state": event["new_state"],
                    "reason": cd_reason,
                })

            # --- Cooldown adaptive sample collection ---
            was_delivered = decision not in ("SUPPRESS", "SUPPRESSED_COOLDOWN",
                                              "WOULD_SUPPRESS", "WOULD_SUPPRESS_COOLDOWN")
            _update_cooldown_adaptive(state, event, category, ts, was_delivered)

            # --- Cooldown adaptive recommendation (rate-limited) ---
            ad_cooldown = CFG.get("adaptive", {}).get("cooldown", {})
            if ad_cooldown.get("enabled", True):
                cd_samples = state.get("cooldown", {}).get("samples", {}).get(category, [])
                if len(cd_samples) % 5 == 0:  # check every 5th notification
                    _recalculate_cooldown_recommendation(state, event, category, ts)

            # --- Cleanup stale records BEFORE write ---
            _cleanup_stale_records(state)
            write_state(state_path, state)

        return {
            "decision": decision,
            "category": category,
            "reason": reason,
            "transition_count": len(transitions),
            "suppression_until": suppression_until,
            "cooldown_blocked": decision in ("WOULD_SUPPRESS_COOLDOWN", "SUPPRESSED_COOLDOWN"),
        }

    except Exception as exc:
        LOG.error(
            "FAIL_OPEN: rate-limit state error for %s: %s — "
            "mail will be sent",
            event["hostname"], exc,
        )
        return {
            "decision": "FAIL_OPEN",
            "category": category,
            "reason": f"Rate-limit error: {exc} — mail sent anyway",
        }


def _cap_transitions(transitions, max_count):
    """Cap a transition list after age-based pruning."""
    if len(transitions) > max_count:
        return transitions[-max_count:]
    return transitions


def _cleanup_stale_records(state):
    """Remove hosts and categories with no recent activity.

    Full stale-host scan is rate-limited to once per cleanup interval.
    Per-category pruning (empty categories, child dicts) runs every time.
    """
    now_ts = now()
    stale_host_days = CFG.get("state_retention", {}).get(
        "stale_host_days", 30)
    cleanup_interval = CFG.get("state_retention", {}).get(
        "cleanup_interval_seconds", 3600)
    max_transitions = CFG.get("state_retention", {}).get(
        "max_transitions_per_category", 500)

    # Always prune the current host's transitions for all categories
    # (handled inline in evaluate_rate_limit via prune_transitions)

    # Full scan: rate-limited
    last_cleanup = state.get("_cleanup_last", 0)
    if now_ts - last_cleanup < cleanup_interval:
        return

    state["_cleanup_last"] = now_ts
    stale_cutoff = now_ts - stale_host_days * 86400
    stale_hosts = []

    for hostname, rec in list(state.items()):
        if hostname.startswith("_") or not isinstance(rec, dict):
            continue

        for cat_key in ("host_state", "service_state_ping"):
            cat_rec = rec.get(cat_key)
            if not isinstance(cat_rec, dict):
                continue

            # Cap transition lists
            transitions = cat_rec.get("transitions", [])
            if transitions:
                cat_rec["transitions"] = _cap_transitions(
                    transitions, max_transitions)

            # Remove empty category if no transitions and suppression expired
            if (not transitions
                    and cat_rec.get("suppression_until", 0) <= now_ts):
                # Check adaptive learning — keep if still observing
                ad = cat_rec.get("adaptive", {})
                if ad.get("first_observation", 0) == 0 or ad.get("first_observation", 0) > stale_cutoff:
                    rec.pop(cat_key, None)

        # After cleaning categories, check if host is completely stale
        remaining_cats = [k for k in ("host_state", "service_state_ping")
                          if isinstance(rec.get(k), dict)]
        if not remaining_cats:
            # Also check suppression: if any active, keep
            any_suppression = any(
                isinstance(rec.get(k), dict)
                and rec[k].get("suppression_until", 0) > now_ts
                for k in ("host_state", "service_state_ping")
            )
            if not any_suppression:
                stale_hosts.append(hostname)

    for hostname in stale_hosts:
        del state[hostname]

    if stale_hosts:
        LOG.debug("Cleaned up %d stale host records", len(stale_hosts))

    # Cooldown sample retention
    cd_tracking = state.get("cooldown", {})
    cd_samples = cd_tracking.get("samples", {})
    for cat in ("host_state", "service_state_ping"):
        samples = cd_samples.get(cat, [])
        if not samples:
            continue
        # Age-based pruning
        cutoff = now_ts - 30 * 86400
        samples[:] = [s for s in samples if s >= cutoff]
        # Cap by count
        if len(samples) > 500:
            samples[:] = samples[-500:]
        cd_samples[cat] = samples


# ---------------------------------------------------------------------------
# Cooldown evaluation
# ---------------------------------------------------------------------------


def _get_cooldown_seconds(category):
    """Return effective cooldown seconds for a category.

    Checks per_category override first, then default_seconds.
    """
    cd = CFG.get("cooldown", {})
    per_cat = cd.get("per_category", {})
    if category in per_cat and per_cat[category]:
        return per_cat[category]
    return cd.get("default_seconds", 3600)


def _is_recovery(event):
    """Detect whether this notification is a recovery.

    Recovery = the new state is UP (host) or OK (service).
    """
    if event["is_host"]:
        return event["new_state"] in ("UP",)
    return event["new_state"] in ("OK",)


def _evaluate_cooldown(state, event, category, ts):
    """Evaluate cooldown for a (host, category) pair.

    Decision order:
      1. If cooldown disabled → BYPASS
      2. If recovery and preserve_recovery → BYPASS_RECOVERY
      3. If last_delivery + cooldown > now → SUPPRESS/WOULD_SUPPRESS
      4. Otherwise → PASS

    Returns (decision_string, reason_string).
    """
    cd = CFG.get("cooldown", {})
    if not cd.get("enabled", True):
        return ("BYPASS", "Cooldown disabled")

    cd_mode = cd.get("mode", "audit")
    preserve = cd.get("preserve_recovery", True)

    # Recovery bypass
    if preserve and _is_recovery(event):
        return ("COOLDOWN_BYPASS_RECOVERY",
                "Recovery notification — bypassing cooldown")

    cd_sec = _get_cooldown_seconds(category)
    if cd_sec <= 0:
        return ("BYPASS", "Cooldown seconds is zero or negative")

    # Look up last delivery from cooldown tracking
    cd_tracking = state.get("cooldown", {})
    last_delivered = cd_tracking.get("last_delivered", {})
    cat_map = last_delivered.get(category, {})
    last_ts = cat_map.get(event["hostname"], 0)

    if last_ts <= 0:
        return ("BYPASS", "No previous delivery for this host+category")

    elapsed = ts - last_ts
    if elapsed >= cd_sec:
        return ("BYPASS", "Cooldown expired")

    remaining = cd_sec - elapsed
    if cd_mode == "enforce":
        return ("SUPPRESSED_COOLDOWN",
                f"Cooldown active — {remaining}s remaining since last delivery")
    return ("WOULD_SUPPRESS_COOLDOWN",
            f"Audit mode — would suppress ({remaining}s cooldown remaining)")


def _update_delivery_cooldown(event):
    """Update the last_delivered timestamp in cooldown tracking.

    Called after successful delivery.  Fail-open on error.
    """
    category, _ = is_supported_transition(event)
    if category is None:
        return
    state_path = get_state_path()
    lock_path = get_lock_path(state_path)
    try:
        with StateLock(lock_path):
            state = read_state(state_path)
            state = migrate_state(state)
            if "cooldown" not in state:
                state["cooldown"] = {"last_delivered": {}, "samples": {}}
            cd_tracking = state["cooldown"]
            if "last_delivered" not in cd_tracking:
                cd_tracking["last_delivered"] = {}
            if category not in cd_tracking["last_delivered"]:
                cd_tracking["last_delivered"][category] = {}
            cd_tracking["last_delivered"][category][event["hostname"]] = now()
            write_state(state_path, state)
    except Exception as exc:
        LOG.warning("FAIL_OPEN: cooldown state update error: %s", exc)


# ---------------------------------------------------------------------------
# Cooldown adaptive learning
# ---------------------------------------------------------------------------


def _update_cooldown_adaptive(state, event, category, ts, was_delivered):
    """Collect cooldown samples for adaptive recommendation.

    Adds a sample timestamp for each delivery (or would-suppress)
    to the cooldown samples list for the category.
    Handles retention: 30 days, max 500 per category.
    """
    ad = CFG.get("adaptive", {}).get("cooldown", {})
    if not ad.get("enabled", True):
        return
    try:
        if "cooldown" not in state:
            state["cooldown"] = {"last_delivered": {}, "samples": {}}
        samples = state["cooldown"].setdefault("samples", {})
        if category not in samples:
            samples[category] = []
        samples[category].append(ts)
        # Retention: 30 days
        cutoff = ts - 30 * 86400
        samples[category] = [s for s in samples[category] if s >= cutoff]
        # Cap by count
        max_samples = 500
        if len(samples[category]) > max_samples:
            samples[category] = samples[category][-max_samples:]
    except Exception as exc:
        LOG.warning("FAIL_OPEN: cooldown adaptive sample error: %s", exc)


def _recalculate_cooldown_recommendation(state, event, category, ts):
    """Calculate and log an adaptive cooldown recommendation.

    Tests each candidate cooldown value against historical samples
    and reports expected reduction.  Logs ADAPTIVE_COOLDOWN_RECOMMENDATION.
    Never changes active configuration.
    """
    ad = CFG.get("adaptive", {}).get("cooldown", {})
    if not ad.get("enabled", True):
        return

    min_samples = ad.get("minimum_notification_samples", 20)
    min_days = ad.get("minimum_learning_days", 3)
    min_reduction = ad.get("minimum_expected_reduction_percent", 30)
    candidates = ad.get("candidate_cooldowns", _COOLDOWN_CANDIDATES)

    try:
        tracking = state.get("cooldown", {})
        samples = tracking.get("samples", {}).get(category, [])

        if len(samples) < min_samples:
            LOG.info("ADAPTIVE_COOLDOWN_RECOMMENDATION: "
                     "insufficient samples (%d < %d) for %s/%s",
                     len(samples), min_samples, event["hostname"], category)
            return

        # Check learning period
        first_ts = min(samples) if samples else ts
        learning_days = (ts - first_ts) / 86400
        if learning_days < min_days:
            LOG.info("ADAPTIVE_COOLDOWN_RECOMMENDATION: "
                     "learning period too short (%.1f < %d days) for %s/%s",
                     learning_days, min_days, event["hostname"], category)
            return

        total_notifications = len(samples)
        best_candidate = candidates[0]
        best_reduction = 0

        for cd_sec in candidates:
            would_pass = 0
            would_block = 0
            last_delivery = 0
            for s_ts in sorted(samples):
                if last_delivery and (s_ts - last_delivery) < cd_sec:
                    would_block += 1
                else:
                    would_pass += 1
                    last_delivery = s_ts

            reduction = (would_block / total_notifications * 100) if total_notifications else 0
            if reduction > best_reduction:
                best_reduction = reduction
                best_candidate = cd_sec

        auto_apply_msg = str(ad.get("auto_apply", False)).lower()
        if best_reduction >= min_reduction:
            LOG.info("ADAPTIVE_COOLDOWN_RECOMMENDATION: "
                     "%s/%s best_candidate=%ds expected_reduction=%.0f%% "
                     "samples=%d learning_days=%.1f auto_apply=%s",
                     event["hostname"], category,
                     best_candidate, best_reduction,
                     total_notifications, learning_days, auto_apply_msg)
            # --- Auto-apply cooldown if enabled ---
            if ad.get("auto_apply", False):
                try:
                    cfg_path = Path(CONFIG_PATH)
                    cfg_data = json.loads(cfg_path.read_text()) if cfg_path.is_file() else {}
                    prev_sec = cfg_data.get("cooldown", {}).get("default_seconds")
                    if "cooldown" not in cfg_data:
                        cfg_data["cooldown"] = {}
                    cfg_data["cooldown"]["default_seconds"] = best_candidate
                    if "per_category" not in cfg_data["cooldown"]:
                        cfg_data["cooldown"]["per_category"] = {}
                    cfg_data["cooldown"]["per_category"][category] = best_candidate
                    cfg_path.write_text(json.dumps(cfg_data, indent=4))
                    LOG.info("ADAPTIVE_COOLDOWN_AUTO_APPLY: "
                             "%s/%s cooldown=%ds (was %s) "
                             "expected_reduction=%.0f%%",
                             event["hostname"], category,
                             best_candidate, str(prev_sec or "default"),
                             best_reduction)
                    # Update in-memory CFG for current invocation
                    if "cooldown" not in CFG:
                        CFG["cooldown"] = {}
                    CFG["cooldown"]["default_seconds"] = best_candidate
                    if "per_category" not in CFG["cooldown"]:
                        CFG["cooldown"]["per_category"] = {}
                    CFG["cooldown"]["per_category"][category] = best_candidate
                except Exception as aa_exc:
                    LOG.warning("AUTO_APPLY_ERROR: %s/%s: %s",
                               event["hostname"], category, aa_exc)
        else:
            LOG.info("ADAPTIVE_COOLDOWN_RECOMMENDATION: "
                     "%s/%s insufficient reduction (%.0f%% < %d%%) "
                     "for any candidate — samples=%d learning_days=%.1f",
                     event["hostname"], category,
                     best_reduction, min_reduction,
                     total_notifications, learning_days)
    except Exception as exc:
        LOG.warning("FAIL_OPEN: cooldown recommendation error: %s", exc)


# ---------------------------------------------------------------------------
# Adaptive learning subsystem
# ---------------------------------------------------------------------------

def _fresh_learning_record():
    """Return a fresh adaptive learning record for one category."""
    return {
        "schema_version": 1,
        "first_observation": 0,
        "last_recalculation": 0,
        "transition_samples": [],
        "window_counts_30m": [],
        "window_counts_60m": [],
        "daily_transition_counts": {},
        "peak_30m": 0,
        "peak_60m": 0,
        "recommended_threshold": None,
        "recommendation_status": "INSUFFICIENT_DATA",
    }


def _ensure_adaptive(cat_rec):
    """Return or create the adaptive sub-record for a category record."""
    if "adaptive" not in cat_rec:
        cat_rec["adaptive"] = _fresh_learning_record()
    return cat_rec["adaptive"]


def _update_adaptive(cat_rec, category, is_transition, ts):
    """Update adaptive learning data for a single event.

    This runs on every notification to keep counters fresh.
    Recommendation recalculation is rate-limited to once every
    recalculate_every_hours.
    """
    adaptive_cfg = CFG.get("adaptive", {})
    if not adaptive_cfg.get("enabled", True):
        return
    if adaptive_cfg.get("mode") != "learning":
        return

    try:
        ad = _ensure_adaptive(cat_rec)

        if ad["first_observation"] == 0:
            ad["first_observation"] = ts

        # Record transition sample
        if is_transition:
            samples = ad.get("transition_samples", [])
            samples.append(ts)
            # Retention: keep only last 30 days
            retention = 30 * 86400
            cutoff = ts - retention
            samples[:] = [s for s in samples if s >= cutoff]
            # Cap by count after age pruning
            max_samples = CFG.get("state_retention", {}).get(
                "max_transitions_per_category", 500)
            if len(samples) > max_samples:
                samples[:] = samples[-max_samples:]
            ad["transition_samples"] = samples

            # Daily count
            day_key = time.strftime("%Y-%m-%d", time.gmtime(ts))
            daily = ad.get("daily_transition_counts", {})
            daily[day_key] = daily.get(day_key, 0) + 1
            # Retention: keep only last 90 days
            old_days = [k for k in daily if k < time.strftime(
                "%Y-%m-%d", time.gmtime(ts - 90 * 86400))]
            for k in old_days:
                del daily[k]
            ad["daily_transition_counts"] = daily

            # Sliding window counts
            obs_window = CFG.get(category, {}).get("observation_window", 1800)
            window_30m = obs_window
            window_60m = max(obs_window, 3600)

            recent_30m = [s for s in samples if s >= ts - window_30m]
            recent_60m = [s for s in samples if s >= ts - window_60m]

            wc30 = ad.get("window_counts_30m", [])
            wc30.append(len(recent_30m))
            ad["window_counts_30m"] = wc30[-100:]  # bounded
            ad["peak_30m"] = max(ad.get("peak_30m", 0), len(recent_30m))

            wc60 = ad.get("window_counts_60m", [])
            wc60.append(len(recent_60m))
            ad["window_counts_60m"] = wc60[-100:]
            ad["peak_60m"] = max(ad.get("peak_60m", 0), len(recent_60m))

        # Rate-limited recalculation (once every 24h unless explicitly overridden)
        recalc_every = adaptive_cfg.get("recalculate_every_hours", 24) * 3600
        if ts - ad.get("last_recalculation", 0) >= recalc_every:
            _recalculate_recommendation(cat_rec, category, adaptive_cfg, ts)
            ad["last_recalculation"] = ts

    except Exception as exc:
        LOG.warning(
            "FAIL_OPEN: adaptive learning error for category=%s: %s",
            category, exc,
        )


def _recalculate_recommendation(cat_rec, category, adaptive_cfg, ts):
    """Calculate a recommended threshold from historical data.

    The recommendation is derived from the configured percentile of
    observed window transition counts, plus a safety margin, clamped
    to hard limits.

    The recommendation is never written into the active configuration.
    """
    ad = _ensure_adaptive(cat_rec)
    samples = ad.get("transition_samples", [])
    first_obs = ad.get("first_observation", 0)

    min_days = adaptive_cfg.get("minimum_learning_days", 14)
    min_samples = adaptive_cfg.get("minimum_transition_samples", 20)
    pct = adaptive_cfg.get("percentile", 95)
    margin = adaptive_cfg.get("safety_margin", 2)

    # Check minimum requirements
    learning_days = (ts - first_obs) / 86400 if first_obs else 0
    total_samples = len(samples)

    if learning_days < min_days or total_samples < min_samples:
        ad["recommended_threshold"] = None
        ad["recommendation_status"] = "INSUFFICIENT_DATA"
        return

    # Compute percentile from window counts
    if category == "host_state":
        window_counts = ad.get("window_counts_30m", [])
    else:
        window_counts = ad.get("window_counts_30m", [])

    if not window_counts:
        ad["recommended_threshold"] = None
        ad["recommendation_status"] = "INSUFFICIENT_DATA"
        return

    sorted_counts = sorted(window_counts)
    idx = int(math.ceil(pct / 100.0 * len(sorted_counts))) - 1
    idx = int(math.ceil(pct / 100.0 * len(sorted_counts))) - 1
    idx = max(0, min(idx, len(sorted_counts) - 1))
    p95_value = sorted_counts[idx]

    raw_recommendation = p95_value + margin

    # Apply hard limits
    if category == "host_state":
        hard_min = 4
        hard_max = 10
    else:
        hard_min = 6
        hard_max = 20

    clamped = max(hard_min, min(hard_max, raw_recommendation))

    # Determine status
    if raw_recommendation > hard_max:
        status = "EXCESSIVE_INSTABILITY"
        clamped = hard_max
    elif clamped > CFG.get(category, {}).get("trigger_transitions", hard_min):
        status = "RECOMMEND_HIGHER_THRESHOLD"
    elif clamped < CFG.get(category, {}).get("trigger_transitions", hard_min):
        status = "RECOMMEND_LOWER_THRESHOLD"
    else:
        status = "STABLE"

    ad["recommended_threshold"] = clamped
    ad["recommendation_status"] = status


