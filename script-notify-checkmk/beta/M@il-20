STATE_SCHEMA_VERSION = 3


def get_state_path():
    """Return the path to the shared state file."""
    path = Path(STATE_DIR)
    path.mkdir(parents=True, exist_ok=True)
    return path / "state.json"


_STATE_SIZE_LIMIT = 10 * 1024 * 1024  # 10 MB safety threshold


def read_state(state_path):
    """Read the JSON state file, returning an empty dict on failure.

    Guards against oversized files: if the file exceeds the safety
    threshold, a warning is logged and normal loading is still
    attempted.  If parsing fails, an empty dict is returned.
    """
    try:
        size = state_path.stat().st_size
        if size > _STATE_SIZE_LIMIT:
            LOG.warning(
                "State file %s is %d bytes — exceeds %d byte limit. "
                "Attempting to load anyway.",
                state_path, size, _STATE_SIZE_LIMIT,
            )
    except OSError:
        pass
    try:
        raw = state_path.read_bytes()
        data = json.loads(raw)
        if isinstance(data, dict):
            return data
        LOG.warning("State file %s is not a dict — resetting", state_path)
    except (FileNotFoundError, json.JSONDecodeError, OSError) as exc:
        LOG.debug("Cannot read state %s: %s — starting fresh", state_path, exc)
    return {}


def write_state(state_path, state):
    """Atomically write the JSON state file using a temp file + rename."""
    tmp = None
    try:
        fd, tmp_name = tempfile.mkstemp(
            dir=str(state_path.parent),
            prefix=".state_tmp_",
        )
        os.close(fd)
        tmp = Path(tmp_name)
        tmp.write_text(json.dumps(state, indent=2, sort_keys=True))
        tmp.chmod(0o640)
        os.replace(str(tmp), str(state_path))
    except Exception as exc:
        LOG.error("Cannot write state file %s: %s", state_path, exc)
        if tmp and tmp.exists():
            tmp.unlink(missing_ok=True)
        raise


def get_lock_path(state_path):
    """Return the flock-based lock file path (next to the state file)."""
    return state_path.parent / "state.lock"


class StateLock:
    """Context manager for exclusive access to the state file."""

    def __init__(self, lock_path):
        self._lock_path = lock_path
        self._fd = None

    def __enter__(self):
        self._lock_path.parent.mkdir(parents=True, exist_ok=True)
        self._fd = self._lock_path.open("w")
        fcntl.flock(self._fd.fileno(), fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc_info):
        if self._fd:
            fcntl.flock(self._fd.fileno(), fcntl.LOCK_UN)
            self._fd.close()
            self._fd = None
        self._lock_path.unlink(missing_ok=True)


# ---------------------------------------------------------------------------
# State schema migration
# ---------------------------------------------------------------------------

def migrate_state(state):
    """Upgrade state to the current schema version.

    Handles migration:
      v1 → v2: add adaptive learning section per host
      v2 → v3: add cooldown tracking structure (last_delivered + samples)

    Preserves all existing counters.  Fail-safe: never raises.
    """
    sv = state.get("schema_version", 1)

    if sv >= STATE_SCHEMA_VERSION:
        return state

    if sv == 1:
        # v1 → v2: add adaptive learning section per host
        for hostname, rec in list(state.items()):
            if hostname == "schema_version":
                continue
            if not isinstance(rec, dict):
                continue
            for cat in ("host_state", "service_state_ping"):
                cat_rec = rec.get(cat)
                if isinstance(cat_rec, dict):
                    if "adaptive" not in cat_rec:
                        cat_rec["adaptive"] = _fresh_learning_record()
        state["schema_version"] = 2
        LOG.info("State schema migrated v1 → v2")

    if sv == 2:
        # v2 → v3: add cooldown tracking structure
        if "cooldown" not in state:
            state["cooldown"] = {
                "last_delivered": {},
                "samples": {},
            }
        for cat in ("host_state", "service_state_ping"):
            if cat not in state["cooldown"]["last_delivered"]:
                state["cooldown"]["last_delivered"][cat] = {}
            if cat not in state["cooldown"]["samples"]:
                state["cooldown"]["samples"][cat] = []
        # Migrate last_delivery_ts from per-category records if present
        for hostname, rec in list(state.items()):
            if hostname.startswith("_") or not isinstance(rec, dict):
                continue
            for cat in ("host_state", "service_state_ping"):
                cat_rec = rec.get(cat)
                if isinstance(cat_rec, dict):
                    ldt = cat_rec.pop("last_delivery_ts", 0)
                    if ldt:
                        state["cooldown"]["last_delivered"][cat][hostname] = ldt
        state["schema_version"] = 3
        LOG.info("State schema migrated v2 → v3 (cooldown tracking)")

    return state


