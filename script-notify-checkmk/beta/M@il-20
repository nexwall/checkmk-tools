# Known secret environment variable values to redact from all logged output
_KNOWN_SECRET_ENV_VARS = ["TELEGRAM_TOKEN", "SMTP_PASSWORD", "API_KEY"]
_SECRET_VALUES_CACHE = None


def _load_secret_values():
    """Cache known secret values from environment variables."""
    global _SECRET_VALUES_CACHE
    if _SECRET_VALUES_CACHE is not None:
        return _SECRET_VALUES_CACHE
    secrets = []
    for var in _KNOWN_SECRET_ENV_VARS:
        val = os.environ.get(var, "")
        if val:
            secrets.append(val)
    _SECRET_VALUES_CACHE = secrets
    return secrets


_SANITIZE_REGEX = [
    (_re.compile(r'/bot[A-Za-z0-9_:.-]+/'), "/bot[REDACTED]/"),
    (_re.compile(r'(Bearer\s+)[A-Za-z0-9._~+/=-]+', _re.IGNORECASE), r'\1[REDACTED]'),
    (_re.compile(r'((?:[?&])(?:token|key|secret|password|api_key|apiKey)=)[^&\s]+', _re.IGNORECASE), r'\1[REDACTED]'),
    (_re.compile(r'(Authorization:\s*)[^\r\n]+', _re.IGNORECASE), r'\1[REDACTED]'),
]


def _sanitize_text(text):
    """Redact known secrets and sensitive patterns from a string.

    Safe to call with any string — never raises.
    """
    if not isinstance(text, str):
        return str(text) if text is not None else ""
    try:
        for env_val in _load_secret_values():
            if env_val and env_val in text:
                text = text.replace(env_val, "[REDACTED]")
        for pattern, replacement in _SANITIZE_REGEX:
            text = pattern.sub(replacement, text)
    except Exception:
        pass
    return text


def _safe_log(level, record):
    """Emit a structured JSON Lines log record.

    Best-effort — never raises, never blocks delivery.
    Falls back to a single sanitized stderr line on failure.
    """
    try:
        record["level"] = level
        # Sanitize all writable string fields in-place
        for k in list(record.keys()):
            v = record[k]
            if isinstance(v, str):
                record[k] = _sanitize_text(v)
            elif isinstance(v, dict):
                for k2 in list(v.keys()):
                    if isinstance(v[k2], str):
                        v[k2] = _sanitize_text(v[k2])
        line = "NOTIFY_EVENT " + json.dumps(record, default=str, ensure_ascii=False)
        if level == "ERROR":
            LOG.error("%s", line)
        elif level == "WARNING":
            LOG.warning("%s", line)
        else:
            LOG.info("%s", line)
    except Exception:
        try:
            sys.stderr.write("%s: log failure\n" % SCRIPT_NAME)
            sys.stderr.flush()
        except Exception:
            pass


