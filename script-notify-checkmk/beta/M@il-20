def get_color(state):
    """Return an HTML colour for a state label."""
    s = state.upper()
    if s in ("OK", "UP"):
        return "#13d389"
    if s in ("WARNING", "WARN"):
        return "#ffd700"
    if s in ("CRITICAL", "CRIT", "DOWN"):
        return "#ff5151"
    return "#ff9800"


def get_label(state):
    """Return an abbreviated state label."""
    s = state.upper()
    if s == "WARNING":
        return "WARN"
    if s == "CRITICAL":
        return "CRIT"
    if s == "UNKNOWN":
        return "UNKN"
    return s


