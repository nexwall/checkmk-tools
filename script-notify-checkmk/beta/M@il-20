def log_decision(decision, event, rate_info):
    """Write a structured log line for a rate-limit decision.

    Uses _safe_log so that logging failures never propagate into
    business logic.  Output is JSON Lines format.
    """
    adaptive = CFG.get("adaptive", {})
    category = decision.get("category", "?")
    cat_cfg = CFG.get(category, {}) if category else {}
    cd_cfg = CFG.get("cooldown", {})
    cd_mode = cd_cfg.get("mode", "audit")
    cd_sec = _get_cooldown_seconds(category) if category else 0
    log_record = {
        "status": "DECISION",
        "host": event["hostname"],
        "category": category,
        "old_state": event["old_state"],
        "new_state": event["new_state"],
        "decision": decision.get("decision", "?"),
        "transition_count": decision.get("transition_count", "?"),
        "window": cat_cfg.get("observation_window", "?"),
        "suppress_until": decision.get("suppression_until", "?"),
        "reason": decision.get("reason", "?"),
        "adaptive_enabled": adaptive.get("enabled", "?"),
        "adaptive_mode": adaptive.get("mode", "?"),
        "auto_apply": adaptive.get("cooldown", {}).get("auto_apply", False),
        "cooldown_mode": cd_mode,
        "cooldown_seconds": cd_sec,
        "cooldown_blocked": decision.get("cooldown_blocked", False),
    }
    _safe_log("INFO", log_record)


