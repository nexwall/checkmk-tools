# CheckMK Agent Synchronization Configuration
#
# Copy this file to /etc/checkmk-agent-sync/checkmk-agent-sync.env
# and customize for your environment
#
# This file is sourced by checkmk-agent-sync.service
#
# IMPORTANT: The default service template runs in VERIFY_ONLY mode (the
# implicit default when neither --install nor --download-only is passed).
# It does not install or update the agent unless the service template is explicitly changed.
# To enable agent installation, modify the ExecStart directive to add --install.

# CheckMK Server Base URL (without /site)
# Examples:
#   https://monitoring.example.org
#   https://checkmk.example.com:8443
#   https://192.168.1.100
CHECKMK_SERVER_URL=https://monitoring.example.org

# CheckMK Site Name
# The site is part of the URL: https://server/SITE/check_mk/agents/
# Examples:
#   monitoring
#   production
#   testing
CHECKMK_SITE=monitoring

# Optional: Package cache directory
# Default: system temp directory (/tmp)
# Useful to persist downloaded packages across reboots
# PACKAGE_CACHE_DIR=/var/cache/checkmk-agent-sync

# Optional: Force reinstall even if versions match
# Default: false (only install if version differs)
# FORCE_REINSTALL=false

# Optional: Enable verbose logging
# Default: false
# VERBOSE=true

# Optional: Custom target type detection
# Default: auto (automatic detection)
# Supported values: auto, deb, rpm, nethsecurity8, ns8-container
# TARGET_TYPE=auto

# Optional: Timeout for network operations (seconds)
# Default: 60
# OPERATION_TIMEOUT=60
